# Rust build artifacts
/target

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Env files
.env
.env.local
.env.*.local

# Debug logs
*.log

# Backup files
*.bak
*.orig

# macOS
.AppleDouble
.LSOverride

# Linux
.directory

# SQLite databases and their WAL siblings. A locally-run server writes
# coffeeblack.db, which holds the service private key, every transport secret and
# TOTP material — `git add .` in a dev checkout must not be able to commit it.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# WireGuard config files (generated at runtime, contain private keys)
*.conf
!docker-compose.yml

# Vendored binary blobs are CI artifacts, not source. They're produced
# by scripts/build.sh (or the Build and Release workflow) from the
# audited pin files in vendor/*_VERSION. Keeps the repo small and
# forces every release to rebuild from the pinned source list.
/vendor/*.gz
