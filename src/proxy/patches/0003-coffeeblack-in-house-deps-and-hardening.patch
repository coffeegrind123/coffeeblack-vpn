+/// Run the TLS handshake far enough to produce the server flight.
+fn run_tls(
+    config: Arc<rustls::ServerConfig>,
+    client_hello: &[u8],
+    original_dcid: &[u8],
+    scid: &[u8],
+) -> Result<TlsFlight> {
